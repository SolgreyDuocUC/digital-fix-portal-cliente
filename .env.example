# Variables de docker-compose del Portal Cliente. Copiar a .env (no se versiona) y completar.
# (Para correr el backend fuera de Docker se usa backend/.env; ver backend/.env.example.)

# Puertos en el host
PORTAL_FRONTEND_PORT=3000
PORTAL_BACKEND_PORT=8091

# Base de datos del portal (PostgreSQL en contenedor)
PORTAL_DB_USER=portal
PORTAL_DB_PASSWORD=

# JWT propio del portal: al menos 32 caracteres. Generar con: openssl rand -hex 32
PORTAL_JWT_SECRET=

# Debe ser igual a PORTAL_API_KEY de ms-workorders (header X-Portal-Api-Key).
PORTAL_API_KEY=

# Usuarios demo (cliente/vendedor/marketing/jefe de ventas) y cupón BIENVENIDA10.
PORTAL_DATOS_DEMO=true

# Orígenes permitidos por CORS si el frontend se sirve desde otro dominio que el de nginx.
PORTAL_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Microservicios del ERP (el portal los llama directo, no por el bff-gateway).
# Por defecto: servicios corriendo en este mismo equipo (por ejemplo, desde el IDE).
#   - ERP en otro servidor: http://<ip-o-dominio>:<puerto>
#   - ERP en este mismo Docker: no toques esto y usa docker-compose.erp.yml
MS_CATALOG_URL=http://host.docker.internal:8088
MS_WORKORDERS_URL=http://host.docker.internal:8085

# Enlace "Ingreso trabajadores" del pie de página: login del portal de empleados (digitalfix-frontend).
# Se incrusta al compilar el frontend: si lo cambias, vuelve a hacer "docker compose up -d --build".
PORTAL_URL_TRABAJADORES=http://localhost:4200/login
