# Backend del Portal Cliente DigitalFix. Copiar a .env (no se versiona) y completar.

SERVER_PORT=8090
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base del portal (portal_db). Sin estas variables usa H2 en ./data (solo desarrollo).
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/portal_db
# SPRING_DATASOURCE_USERNAME=portal
# SPRING_DATASOURCE_PASSWORD=

# JWT propio del portal: al menos 32 caracteres. Generar con: openssl rand -hex 32
PORTAL_JWT_SECRET=
PORTAL_JWT_EXPIRACION_MINUTOS=60
PORTAL_JWT_EXPIRACION_REFRESH_DIAS=7

# Usuarios demo (cliente/vendedor/marketing/jefe de ventas) y cupón BIENVENIDA10. Ver config/DataInitializer.
PORTAL_DATOS_DEMO=true

# Microservicios del ERP
MS_CATALOG_URL=http://localhost:8088
MS_WORKORDERS_URL=http://localhost:8085
# Debe ser igual a PORTAL_API_KEY de ms-workorders (header X-Portal-Api-Key).
MS_WORKORDERS_API_KEY=
PORTAL_MINUTOS_RESERVA_STOCK=30
